{
  "name": "hostel-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:db": "node supabase/tests/rls.test.mjs && node supabase/tests/seed.test.mjs",
    "seed:accounts": "node --env-file=supabase/seed/seed.env.local supabase/seed/create-test-accounts.mjs",
    "seed:verify": "node --env-file=supabase/seed/seed.env.local supabase/seed/verify-dev-seed.mjs",
    "test:live-dev": "node --env-file=supabase/seed/seed.env.local supabase/tests/live-complaint-probe.mjs",
    "test:ui": "node tests/ui/modal-focus.test.mjs",
    "test": "npm run test:db && npm run test:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
