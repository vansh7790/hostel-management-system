# Copy to supabase/seed/seed.env.local (git-ignored) and fill in values for the
# DEV project only. Never use these names with a VITE_ prefix: the service-role
# key must never reach browser code.
SEED_SUPABASE_URL=https://your-dev-project-ref.supabase.co
SEED_SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
# Must equal the <project-ref> in SEED_SUPABASE_URL; deliberate confirmation step.
SEED_ALLOWED_PROJECT_REF=your-dev-project-ref
# Shared password for all fictional test logins (12+ characters). Do not reuse a real password.
SEED_TEST_PASSWORD=choose-a-long-test-only-password
